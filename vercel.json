{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "bienvenido_a_horasocial_pro_1/**",
          "selecci_n_de_rol_distribuci_n_expandida_vertical/**",
          "sobre_horasocial_pro_identidad_y_prop_sito/**",
          "dashboard_maestro_horasocial_pro/**",
          "gestion_estudiantes_maestro_horasocial_pro/**",
          "gestion_tecnica_maestro_horasocial_pro/**",
          "mensajes_maestro_horasocial_pro/**",
          "chat_maestro_horasocial_pro/**",
          "login_maestro_horasocial_pro/**",
          "recuperar_contrasena_maestro_horasocial_pro/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/", "destination": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/seleccion-rol", "destination": "/server.js" },
    { "src": "/sobre", "destination": "/server.js" },
    { "src": "/profesor/login", "destination": "/server.js" },
    { "src": "/profesor/recuperar-contrasena", "destination": "/server.js" },
    { "src": "/profesor/dashboard", "destination": "/server.js" },
    { "src": "/profesor/estudiantes", "destination": "/server.js" },
    { "src": "/profesor/tecnica", "destination": "/server.js" },
    { "src": "/profesor/chat", "destination": "/server.js" },
    { "src": "/profesor/mensajes", "destination": "/server.js" },
    { "src": "/(.*)", "destination": "/server.js" }
  ]
}
